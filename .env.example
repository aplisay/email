# @aplisay/email — outbound email configuration (read by configFromEnv()).

# Provider id. Supported: smtp2go | console. Unset/"console" logs instead of
# sending (handy for local dev with no credentials).
EMAIL_SEND_TYPE=smtp2go

# Provider endpoint. Optional — defaults to the SMTP2GO public API when omitted.
EMAIL_SEND_URL=https://api.smtp2go.com/v3/email/send

# Provider API key (SMTP2GO: starts with "api-...").
EMAIL_SEND_KEY=

# Optional default sender (used when a message omits `from`). The address must
# be a verified sender in the provider account.
EMAIL_FROM_ADDRESS=hello@aplisay.uk
EMAIL_FROM_NAME="Aplisay"
