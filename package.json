{
  "name": "@aplisay/email",
  "version": "0.1.0",
  "description": "Modular outbound email for Aplisay services — provider-agnostic, SMTP2GO first.",
  "type": "module",
  "license": "MIT",
  "author": "Aplisay Ltd",
  "homepage": "https://github.com/aplisay/email#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aplisay/email.git"
  },
  "bugs": {
    "url": "https://github.com/aplisay/email/issues"
  },
  "keywords": [
    "email",
    "smtp2go",
    "transactional-email",
    "aplisay"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
